class Solution {
     public static class Edge{
        int src;
        int dest;
        int wt;
        public Edge(int src, int dest, int wt){
            this.src = src;
            this.dest = dest;
            this.wt = wt;
        }
    }
   public static void createGraph(List<Edge>[] graph, int[][] points) {
    for(int i = 0; i < graph.length; i++) {
        graph[i] = new ArrayList<>();
    }

    int n = points.length;

    for(int i = 0; i < n; i++) {
        for(int j = i + 1; j < n; j++) {
            int wt = Math.abs(points[i][0] - points[j][0]) +
                     Math.abs(points[i][1] - points[j][1]);

            graph[i].add(new Edge(i, j, wt));
            graph[j].add(new Edge(j, i, wt));
        }
    }
}
    public static class Pair implements Comparable<Pair>{
        int no;
        int wt;
        public Pair(int no, int wt){
            this.no = no;
            this.wt = wt;
        }
        @Override
        public int compareTo(Pair p2){
            return this.wt - p2.wt;
        }
    }
     public static int mst(List<Edge> graph[], boolean vis[], int src){
        PriorityQueue<Pair> pq = new PriorityQueue<>();
        pq.add(new Pair(src, 0));
        int minC = 0;
        while(!pq.isEmpty()){
            Pair pa = pq.remove();
            if(vis[pa.no]!=true){
                vis[pa.no] = true;
                minC+=pa.wt;
                for(int i=0;i<graph[pa.no].size();i++){
                    Edge e = graph[pa.no].get(i);
                    if(vis[e.dest]!=true){
                        pq.add(new Pair(e.dest, e.wt));
                    }
                }
            }
        }
        return minC;
    }
    public int minCostConnectPoints(int[][] points) {
        int V = points.length;
         List<Edge> graph[] = new ArrayList[V];
        boolean vis[] = new boolean[V];
        createGraph(graph, points);
        return mst(graph, vis, 0);
    }
}
