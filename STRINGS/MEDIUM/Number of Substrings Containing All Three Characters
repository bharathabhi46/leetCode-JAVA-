class Solution {
    public int numberOfSubstrings(String s) {
        int n = s.length();
        int i = 0;
        int j = 0;
        int ans = 0;
        int arr[] = new int[3];
        while(j<n){
            char ch = s.charAt(j);
            if(ch == 'a'){
                arr[0]++;
            }
            if(ch == 'b'){
                arr[1]++;
            }
            if(ch == 'c'){
                arr[2]++;
            }
            while(arr[0]!=0 && arr[1]!=0 && arr[2]!=0){
                ans+=n-j;
                char c = s.charAt(i);
                    if(c == 'a'){
                        arr[0]--;
                    }
                    if(c == 'b'){
                        arr[1]--;
                    }
                    if(c == 'c'){
                        arr[2]--;
                    }
                i++;
            }
            j++;
        }
        return ans;
    }
}
