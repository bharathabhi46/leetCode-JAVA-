class Solution {
    public int romanToInt(String s) {
        HashMap<Character, Integer> map = new HashMap<>();
        map.put('I', 1);
        map.put('V', 5);
        map.put('X', 10);
        map.put('L', 50);
        map.put('C', 100);
        map.put('D', 500);
        map.put('M', 1000);
        int res = 0;
        int n = s.length();
        int i = n-1;
        while(i>=1){
            if(s.charAt(i)=='V' && s.charAt(i-1)=='I'){
                res+=4;
                i-=2;
            }
            else if(s.charAt(i)=='X' && s.charAt(i-1)=='I'){
                res+=9;
                i-=2;
            }
            else if(s.charAt(i)=='L' && s.charAt(i-1)=='X'){
                res+=40;
                i-=2;
            }
            else if(s.charAt(i)=='C' && s.charAt(i-1)=='X'){
                res+=90;
                i-=2;
            }
            else if(s.charAt(i)=='D' && s.charAt(i-1)=='C'){
                res+=400;
                i-=2;
            }
            else if(s.charAt(i)=='M' && s.charAt(i-1)=='C'){
                res+=900;
                i-=2;
            }else{
                res+=map.get(s.charAt(i));
                i--;
            }
        }
        if(i>=0) res+=map.get(s.charAt(i));
        return res;
    }
}
